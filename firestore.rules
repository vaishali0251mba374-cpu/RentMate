rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable security primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'fullName', 'email', 'mobile', 'college',
        'accommodationType', 'deliveryAddress', 'city', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'fullName', 'email', 'mobile', 'college',
        'accommodationType', 'deliveryAddress', 'city', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == request.auth.uid &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
      data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 && data.mobile.matches('^[0-9+\\-\\s]{10,15}$') &&
      data.college is string && data.college.size() >= 2 && data.college.size() <= 120 &&
      data.accommodationType in ['Hostel', 'PG', 'Rented Room'] &&
      data.deliveryAddress is string && data.deliveryAddress.size() >= 5 && data.deliveryAddress.size() <= 300 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: RentalBooking
    function isValidRentalBooking(data) {
      return data.keys().hasAll([
        'userId', 'orderNumber', 'customerName', 'customerMobile', 'college',
        'accommodationType', 'deliveryAddress', 'city', 'itemsSummary',
        'itemCount', 'tenureMonths', 'monthlyRent', 'securityDeposit',
        'deliveryFee', 'totalPayableNow', 'paymentMethod', 'deliverySlot',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'orderNumber', 'customerName', 'customerMobile', 'college',
        'accommodationType', 'deliveryAddress', 'city', 'itemsSummary',
        'itemCount', 'tenureMonths', 'monthlyRent', 'securityDeposit',
        'deliveryFee', 'totalPayableNow', 'paymentMethod', 'deliverySlot',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == request.auth.uid &&
      data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32 && data.orderNumber.matches('^[A-Z0-9\\-]+$') &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
      data.customerMobile is string && data.customerMobile.size() >= 10 && data.customerMobile.size() <= 15 && data.customerMobile.matches('^[0-9+\\-\\s]{10,15}$') &&
      data.college is string && data.college.size() >= 2 && data.college.size() <= 120 &&
      data.accommodationType in ['Hostel', 'PG', 'Rented Room'] &&
      data.deliveryAddress is string && data.deliveryAddress.size() >= 5 && data.deliveryAddress.size() <= 300 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      data.itemsSummary is string && data.itemsSummary.size() >= 2 && data.itemsSummary.size() <= 500 &&
      data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 50 &&
      data.tenureMonths in [1, 3, 6, 12] &&
      data.monthlyRent is number && data.monthlyRent >= 0 && data.monthlyRent <= 100000 &&
      data.securityDeposit is number && data.securityDeposit >= 0 && data.securityDeposit <= 200000 &&
      data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 10000 &&
      data.totalPayableNow is number && data.totalPayableNow >= 0 && data.totalPayableNow <= 500000 &&
      data.paymentMethod in ['UPI / QR', 'Cash on Delivery', 'Campus Pay Later'] &&
      data.deliverySlot is string && data.deliverySlot.size() >= 3 && data.deliverySlot.size() <= 80 &&
      data.status in ['Confirmed', 'Scheduled', 'Active Rental', 'Return Requested', 'Cancelled'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: SupportEnquiry
    function isValidSupportEnquiry(data) {
      return data.keys().hasAll([
        'userId', 'name', 'email', 'college', 'topic', 'message', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'name', 'email', 'college', 'topic', 'message', 'createdAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == request.auth.uid &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
      data.college is string && data.college.size() >= 2 && data.college.size() <= 120 &&
      data.topic is string && data.topic.size() >= 2 && data.topic.size() <= 100 &&
      data.message is string && data.message.size() >= 5 && data.message.size() <= 1000 &&
      data.createdAt is timestamp;
    }

    // Private Student Profiles (PII isolated to owner only; listing disallowed)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'mobile', 'college', 'accommodationType', 'deliveryAddress', 'city', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Student Rental Bookings (strictly owner-scoped)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(bookingId) &&
        isVerifiedUser() &&
        isValidRentalBooking(incoming()) &&
        incoming().status == 'Confirmed' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(bookingId) &&
        isVerifiedUser() &&
        isValidRentalBooking(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        !(existing().status in ['Return Requested', 'Cancelled']) &&
        (
          (
            incoming().status in ['Return Requested', 'Cancelled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['deliveryAddress', 'deliverySlot', 'customerMobile', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // Student Support & Pilot Enquiries (strictly owner-scoped, append-only)
    match /enquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(enquiryId) &&
        isVerifiedUser() &&
        isValidSupportEnquiry(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
